# Local SQL Server (the unosof Docker stack: container unosof-mssql-1, port 1433).
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
# Tenants this POC may serve: <subdomain>=<database>, comma separated.
TENANTS=larosaleda=UNOSOF_LAROSALEDA
# Used when the request host does not name a known tenant (e.g. plain localhost).
DEFAULT_TENANT=larosaleda
# Seconds a fetched fact set stays cached in memory.
FACT_CACHE_TTL=900
