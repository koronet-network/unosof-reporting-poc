{
  "name": "unosof-reporting-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of concept: UNOSOF sales reporting on Next.js + Apache ECharts + d3, reading a tenant SQL Server database read-only.",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "typecheck": "tsc --noEmit",
    "env:local": "zsh scripts/write-env-local.sh"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@tanstack/react-table": "8.20.5",
    "d3": "7.9.0",
    "echarts": "5.5.1",
    "echarts-for-react": "3.0.2",
    "exceljs": "4.4.0",
    "mssql": "11.0.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/mssql": "9.1.5",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
